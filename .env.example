# ──────────────────────────────────────────────────────────────────────────
#  Comitra — root environment file
#
#  1. Copy this file to ".env"  ->  cp .env.example .env
#  2. Fill in the values (see TWILIO_SETUP.md for the Twilio ones).
#  3. NEVER commit ".env" — it is already in .gitignore.
#
#  RULE: only VITE_* variables are inlined into the browser bundle by Vite.
#  Anything secret must NOT have the VITE_ prefix.
# ──────────────────────────────────────────────────────────────────────────

# ── Frontend (public, shipped in the bundle) ──────────────────────────────

# Public PayPal Client ID (safe to expose). The PayPal SECRET goes in server/.env.
VITE_PAYPAL_CLIENT_ID=

# URL of the backend (server/). Required for SMS: every Twilio call goes
# through it. e.g. http://localhost:4000 in development.
VITE_API_BASE=

# Public Google OAuth 2.0 Web client id (enables "Continue with Google").
VITE_GOOGLE_CLIENT_ID=

# Supabase project URL + public anon key (cross-device judge sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Whether the judge-invite flow asks for an SMS code.
#   auto (default) — on only when the backend reports working Twilio credentials
#   off            — never ask for a code
VITE_SMS_VERIFY=auto

# ── Twilio (SMS) — BACKEND ONLY, never exposed to the client ──────────────
#
# Read by server/ (see server/src/env.js). Fill every value in and nothing else
# needs changing — no code edits. Leave them all empty and SMS is simply off
# (judges register with no code step). A HALF-filled block makes the server
# refuse to boot, on purpose.
#
# Where to find each value: TWILIO_SETUP.md

# Console → Account Info → "Account SID"  (starts with AC)
TWILIO_ACCOUNT_SID=
# Console → Account → API keys & tokens → Create API key  (starts with SK)
TWILIO_API_KEY_SID=
# Shown ONCE when the API key is created — copy it then, it cannot be re-read.
TWILIO_API_KEY_SECRET=
# Console → Account Info → "Auth Token". Used ONLY to verify webhook signatures.
TWILIO_AUTH_TOKEN=
# Console → Verify → Services → your service  (starts with VA)
TWILIO_VERIFY_SERVICE_SID=
# Console → Messaging → Services → your service  (starts with MG)
TWILIO_MESSAGING_SERVICE_SID=
# Public https URL of the backend + /api/twilio/status-callback.
# Optional: leave empty to skip delivery receipts.
TWILIO_STATUS_CALLBACK_URL=
