# ──────────────────────────────────────────────────────────────────────────
#  Comitra — root environment file
#
#  1. Copy this file to ".env"  ->  cp .env.example .env
#  2. Fill in the values (SES_SETUP.md for Amazon SES).
#  3. NEVER commit ".env" — it is already in .gitignore.
#
#  RULE: only VITE_* variables are inlined into the browser bundle by Vite.
#  Anything secret must NOT have the VITE_ prefix.
# ──────────────────────────────────────────────────────────────────────────

# ── Frontend (public, shipped in the bundle) ──────────────────────────────

# Public PayPal Client ID (safe to expose). The PayPal SECRET goes in server/.env.
VITE_PAYPAL_CLIENT_ID=

# URL of the backend. Required for the sign-up email code and for the judge
# invite: every SES call goes through it. e.g. http://localhost:4000 in
# development, or https://<project>.supabase.co/functions/v1 for the Edge
# Function backend.
VITE_API_BASE=

# Public Google OAuth 2.0 Web client id (enables "Continue with Google").
VITE_GOOGLE_CLIENT_ID=

# Supabase project URL + public anon key (cross-device judge sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Whether sign-up AND the judge invite ask for the 6-digit code emailed by
# Amazon SES.
#   auto (default) — on only when the backend reports working SES settings
#   off            — never ask for a code (the account is created straight away)
VITE_EMAIL_VERIFY=auto

# ── Amazon SES (sign-up email codes) — BACKEND ONLY, never in the bundle ───
#
# Read by server/ (see server/src/email/config.js). Fill in the region and the
# From address and nothing else needs changing — no code edits. Leave them both
# empty and email verification is simply off (sign-up skips the code step).
# A HALF-filled block makes the server refuse to boot, on purpose.
#
# Step-by-step, including domain verification and leaving the sandbox:
# SES_SETUP.md

# The region your domain identity is verified in, e.g. eu-central-1.
# An identity verified in one region does not exist in another.
SES_REGION=
# A verified sender on your domain. Bare address only — no display name.
SES_FROM_EMAIL=
# Optional. The display name shown next to it. Defaults to "Comitra".
SES_FROM_NAME=Comitra
# Optional. Where replies go, if that is a different mailbox.
SES_REPLY_TO=
# Optional. SES configuration set, if you use one for bounce/complaint events.
SES_CONFIGURATION_SET=

# Optional. A SES-hosted template for the sign-up code. When set, the subject and
# both bodies live in AWS and this server sends only the six digits. Blank = use
# the built-in copy in server/src/email/templates.js.
SES_TEMPLATE_NAME=
# The placeholder the template uses for the code — the bare word between {{ }}.
# Defaults to "code". A wrong name renders the email with an empty code box.
SES_TEMPLATE_VAR=

# ── AWS credentials for SES ────────────────────────────────────────────────
# LEAVE BOTH EMPTY when the backend runs on AWS with an IAM role attached
# (EC2/ECS/App Runner/Lambda) or when the machine has an AWS profile — the SDK
# finds credentials on its own, and no long-lived key has to exist.
# Set them together, never one alone, for an IAM user with ses:SendEmail only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
